{
  "name": "unreal-launcher",
  "productName": "Unreal Launcher",
  "version": "1.0.0",
  "description": "Launcher de Minecraft Java Edition seguro y modular.",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main/main.js",
  "author": "Unreal Launcher",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "start": "npm run build:dev && electron .",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "node --import tsx --test --test-timeout=120000 test/unit/*.test.ts",
    "test:server": "npm --prefix server test",
    "test:e2e": "node --import tsx test/e2e/ui.e2e.ts",
    "sign-manifest": "node scripts/sign-update-manifest.mjs",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg --publish never"
  },
  "dependencies": {
    "yauzl": "2.10.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@types/yauzl": "2.10.3",
    "electron": "44.9.3",
    "electron-builder": "26.0.12",
    "esbuild": "0.25.5",
    "playwright": "1.53.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-icons": "5.5.0",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  },
  "build": {
    "appId": "dev.unreallauncher.app",
    "productName": "Unreal Launcher",
    "copyright": "Unreal Launcher",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "artifactName": "UnrealLauncher-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "shortcutName": "Unreal Launcher"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Game",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.games",
      "icon": "build/icon.png",
      "hardenedRuntime": true
    },
    "publish": null
  }
}
