# Copia a .env (NO lo subas al repositorio) o usa *_FILE con secretos montados.
PORT=8787
HOST=0.0.0.0
DB_PATH=./data/authority.db
# Genera ambos con: npm run admin -- gen-secrets
KEY_PEPPER=
SIGNING_KEY=
# Detrás de un proxy inverso (Caddy/Nginx) que termina TLS:
TRUST_PROXY=1
# Opcionales
PREMIUM_SESSION_TTL_H=12
DEVICE_SESSION_TTL_D=30
GRANT_TTL_D=7
